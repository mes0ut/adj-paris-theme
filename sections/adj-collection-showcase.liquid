{%- comment -%}
  adj-collection-showcase.liquid
  ─────────────────────────────────────────────────────────────────────────
  4 kare görsel (2x2 grid, sol taraf) + 1 tam boy dikey görsel (sağ taraf).
  Her blok elle seçilen görsel + kendi linki + opsiyonel üzerine yazı.
  Blok sırası önemli: ilk 4 blok sol gride, 5. blok sağdaki büyük görsele.
{%- endcomment -%}

{% liquid
  render 'section-spacing', id: section.id
%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .adj-showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.gap }}px;
  }

  #shopify-section-{{ section.id }} .adj-showcase__quad {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: {{ section.settings.gap }}px;
  }

  #shopify-section-{{ section.id }} .adj-showcase__tile {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .adj-showcase__tall {
    position: relative;
    display: block;
    overflow: hidden;
    height: 100%;
    background-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .adj-showcase__tile img,
  #shopify-section-{{ section.id }} .adj-showcase__tall img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .adj-showcase__tile:hover img,
  #shopify-section-{{ section.id }} .adj-showcase__tall:hover img {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .adj-showcase__label {
    position: absolute;
    left: 1.6rem;
    bottom: 1.6rem;
    right: 1.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .adj-showcase__tall .adj-showcase__label {
    font-size: 1.4rem;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .adj-showcase {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .adj-showcase__tall {
      aspect-ratio: 3 / 4;
      height: auto;
    }
  }
#shopify-section-{{ section.id }} .adj-showcase__heading-wrap {
    padding-left: var(--page-width-padding);
    padding-right: var(--page-width-padding);
  }
{%- endstyle -%}

<div class="section-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="adj-showcase__heading-wrap">
      <h2
        class="{{ section.settings.heading_size }}"
        style="text-align: {{ section.settings.heading_align }}; margin-bottom: 2.4rem;"
      >
        {{ section.settings.heading }}
      </h2>
    </div>
  {%- endif -%}

  <div class="adj-showcase" {{ section.shopify_attributes }}>
    <div class="adj-showcase__quad">
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign tile_class = 'adj-showcase__tile'
          assign img_widths = '400, 600, 800'
          assign img_sizes = '(min-width: 750px) 25vw, 50vw'
        -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="{{ tile_class }}" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="{{ tile_class }}" {{ block.shopify_attributes }}>
        {%- endif -%}

          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: img_widths, sizes: img_sizes, alt: block.settings.image.alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            <span class="adj-showcase__label" style="color: {{ block.settings.text_color }};">
              {{ block.settings.label }}
            </span>
          {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign fifth_block = section.blocks[4] -%}
    {%- if fifth_block -%}
      {%- if fifth_block.settings.link != blank -%}
        <a href="{{ fifth_block.settings.link }}" class="adj-showcase__tall" {{ fifth_block.shopify_attributes }}>
      {%- else -%}
        <div class="adj-showcase__tall" {{ fifth_block.shopify_attributes }}>
      {%- endif -%}

        {%- if fifth_block.settings.image != blank -%}
          {{
            fifth_block.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '50vw', alt: fifth_block.settings.image.alt
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- if fifth_block.settings.label != blank -%}
          <span class="adj-showcase__label" style="color: {{ fifth_block.settings.text_color }};">
            {{ fifth_block.settings.label }}
          </span>
        {%- endif -%}

      {%- if fifth_block.settings.link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ADJ – Koleksiyon Vitrini",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık (opsiyonel)",
      "default": "Découvrez la collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Başlık boyutu",
      "options": [
        { "value": "h3", "label": "Küçük" },
        { "value": "h2", "label": "Orta" },
        { "value": "h1", "label": "Büyük" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Başlık hizası",
      "options": [
        { "value": "left", "label": "Sol" },
        { "value": "center", "label": "Orta" },
        { "value": "right", "label": "Sağ" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Görseller arası boşluk (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Üst boşluk",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Alt boşluk",
      "default": 60
    },
    {
      "type": "header",
      "content": "Padding (mobil)"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Üst boşluk (mobil)",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Alt boşluk (mobil)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Görsel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Görsel"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Koleksiyon / sayfa linki"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Üzerine yazılacak metin (opsiyonel)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Metin rengi",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ADJ – Koleksiyon Vitrini",
      "category": "Koleksiyonlar",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
