{%- comment -%}
  adj-font-trial.liquid — DENEME AMAÇLI, KALICI DEĞİL
  ─────────────────────────────────────────────────────────────────────────
  Switzer'ı (Fontshare, ücretsiz) sitenin tüm başlık/gövde fontlarının yerine
  geçici olarak yükler. Beğenilirse settings_schema.json'daki font_picker
  ayarlarını kalıcı hale getiririz; beğenilmezse theme.liquid'den bu render
  satırını silmek yeterli, hiçbir iz bırakmaz.
{%- endcomment -%}
<style>
  @import url('https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700&display=swap');

  :root {
    --font-body-family: 'Switzer', var(--font-body-family);
    --font-body-weight: 400;
    --font-body-style: normal;

    --font-subheading-family: 'Switzer', var(--font-subheading-family);
    --font-subheading-weight: 500;
    --font-subheading-style: normal;

    --font-heading-family: 'Switzer', var(--font-heading-family);
    --font-heading-weight: 600;
    --font-heading-style: normal;
  }
</style>
